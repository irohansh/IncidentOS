# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── GitHub (required for deploy-risk correlation and postmortem issue creation) ──
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo

# ── Slack (required for incident comms) ───────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_INCIDENT_CHANNEL_ID=C0123456789

# ── Dashboard API key (recommended in production) ─────────────────────────────
# When set, all POST /api/approve requests must include: Authorization: Bearer <key>
# Leave unset in local dev for convenience.
DASHBOARD_API_KEY=

# ── PagerDuty webhook signing (optional — verifies request origin) ────────────
PAGERDUTY_WEBHOOK_SECRET=

# ── Metrics backends (optional — zeroed snapshots if unset) ───────────────────
PROMETHEUS_URL=https://prometheus.internal
GRAFANA_URL=https://grafana.internal
GRAFANA_API_KEY=

# ── Branding (used in comms drafts) ───────────────────────────────────────────
COMPANY_NAME=Acme
PRODUCT_NAME=Platform
STATUS_PAGE_URL=https://status.example.com
SUPPORT_EMAIL=support@example.com

# ── Execution safety ──────────────────────────────────────────────────────────
# Set to true only on hosts with kubectl/psql/redis-cli configured and credentialed
ENABLE_REAL_EXECUTION=false

# ── Timing (milliseconds) — lower values speed up tests ──────────────────────
APPROVAL_TIMEOUT_MS=300000
METRICS_INITIAL_DELAY_MS=2000
METRICS_SAMPLE_DELAY_MS=30000
AGENT_TIMEOUT_MS=300000

# ── Testing ───────────────────────────────────────────────────────────────────
# Set to true in CI to skip the human approval polling step
TEST_AUTO_APPROVE=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
