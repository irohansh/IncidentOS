{
  "name": "incidentos",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && next build",
    "build:api": "tsc -p tsconfig.server.json",
    "build:dashboard": "next build",
    "dev": "ts-node --project tsconfig.server.json src/webhook/server.ts",
    "start:webhook": "NODE_ENV=production node dist/webhook/server.js",
    "start:worker": "NODE_ENV=production node dist/worker.js",
    "start:dashboard": "NODE_ENV=production node_modules/.bin/next start -p 3001",
    "dashboard": "next dev -p 3001",
    "migrate": "ts-node --project tsconfig.server.json src/db/migrate.ts",
    "setup:env": "ts-node --project tsconfig.server.json scripts/setup-env.ts",
    "check:env": "ts-node --project tsconfig.server.json scripts/check-env.ts",
    "user:add": "ts-node --project tsconfig.server.json scripts/user-add.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "ts-node --project tsconfig.server.json src/tests/run-test.ts",
    "verify:db": "ts-node --project tsconfig.server.json src/tests/manual/db-longgap.ts"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "nanoid": "^3.3.20",
    "ip-address": "^10.7.4",
    "source-map-js": "^1.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@octokit/rest": "^22.0.1",
    "@slack/web-api": "^8.2.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.2.0",
    "next": "^16.4.2",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
